# Pin these to immutable commit-SHA tags before integration/E2E runs.
COREAIGENT_IMAGE_REGISTRY=ghcr.io/your-org
OCR_IMAGE=ghcr.io/your-org/coreaigent-ocr:REPLACE_WITH_COMMIT_SHA
CLASSIFICATION_IMAGE=ghcr.io/your-org/coreaigent-classification:REPLACE_WITH_COMMIT_SHA
VALIDATION_IMAGE=ghcr.io/your-org/coreaigent-validation:REPLACE_WITH_COMMIT_SHA
RAG_IMAGE=ghcr.io/your-org/coreaigent-rag:REPLACE_WITH_COMMIT_SHA
LLM_IMAGE=ghcr.io/your-org/coreaigent-llm:REPLACE_WITH_COMMIT_SHA
WORKFLOW_IMAGE=ghcr.io/your-org/coreaigent-workflow:REPLACE_WITH_COMMIT_SHA

# Real local Jamba overlay (compose.llm.yaml). Both lanes serve the same
# upstream model; pin the 40-character commit SHA so a run can never quietly
# resolve to a different snapshot than the one that was smoked.
MODEL_ID=ai21labs/AI21-Jamba2-3B
MODEL_REVISION=525c6c8e1d9f5bddedfbdc1dbb0ade2df84230c9
HF_HUB_OFFLINE=1
# Optional: bind an existing HF cache instead of the llm-hf-cache volume.
# HF_CACHE_DIR=/absolute/path/to/huggingface-cache

# GGUF lane (compose.llm.gguf.yaml) for hosts without an NVIDIA GPU: a host
# llama.cpp Vulkan server holds the weights and the container only adapts it.
# Start the server first with scripts/jamba-gguf-server.ps1, then bring the
# overlay up.  The server binds 0.0.0.0 so containers can reach it, so keep the
# host firewall on Private and set LLAMA_API_KEY on shared networks.
# LLAMA_SERVER_URL=http://host.docker.internal:8090
# GGUF_FILE=ai21labs_AI21-Jamba2-3B-Q8_0.gguf
# LLAMA_API_KEY=
# COREAIGENT_GGUF_ROOT=/absolute/path/for/llama.cpp-and-gguf

# The workflow/worker image installs a CPU-only Torch for BGE-M3 embedding.  On
# a CUDA host that already builds compose.llm.yaml, point this at that image to
# reuse its Torch instead of installing a second one.
# WORKFLOW_BASE_IMAGE=coreaigent/llm:jamba-local
