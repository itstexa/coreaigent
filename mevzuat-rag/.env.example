# --- Portability (config.py + device.py) ---
# RAG_PROFILE=dev_gpu|edge|cpu_only|prod — boş bırakılırsa "default" (config/default.yaml)
RAG_PROFILE=
# DEVICE=cuda|mps|cpu — boş bırakılırsa resolve_device() otomatik seçer
DEVICE=
# DATA_DIR — boş bırakılırsa proje kökü altında ./data
DATA_DIR=

# --- DeepSeek (generation step, mevzuat_rag/generation.py) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Qdrant (embedding storage) ---
# Boş bırakılırsa QDRANT_LOCAL_PATH altında embedded/yerel Qdrant kullanılır.
QDRANT_URL=
QDRANT_LOCAL_PATH=./data/qdrant_local
QDRANT_COLLECTION_MEVZUAT=mevzuat_chunks

# --- Embedding (BAAI/bge-m3, sentence-transformers — insangram ile aynı desen) ---
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DEVICE=cpu

# --- Chunking ---
RAG_CHUNK_MAX_TOKENS=768
RAG_CHUNK_OVERLAP_TOKENS=80
RAG_RETRIEVAL_TOP_K=5

# --- İsteğe bağlı ingestion kaynakları ---
RESMI_GAZETE_RSS_URL=https://www.resmigazete.gov.tr/rss
AGENT_REACH_JINA_READER_BASE_URL=https://r.jina.ai
