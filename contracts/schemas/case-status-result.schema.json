{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case-status-result",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "case_revision", "state", "completed_steps", "last_error_code", "updated_at", "validation_status", "routing_status", "applicant_notifications"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1}, "case_revision": {"type": "integer", "minimum": 1}, "state": {"type": "string", "minLength": 1}, "completed_steps": {"type": "array", "items": {"type": "string"}}, "last_error_code": {"type": ["string", "null"]}, "updated_at": {"type": "string", "minLength": 1}, "validation_status": {"enum": ["complete", "missing_information", "invalid_information", null]}, "routing_status": {"enum": ["not_routed", "routed"]}, "applicant_notifications": {"type": "array", "items": {"$ref": "#/$defs/applicant_notice"}}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "case_revision", "state", "completed_steps", "last_error_code", "updated_at", "validation_status", "routing_status", "applicant_notifications", "routing", "target_unit_notification", "ticket", "action_log", "learning_feedback"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1}, "case_revision": {"type": "integer", "minimum": 1}, "state": {"type": "string", "minLength": 1}, "completed_steps": {"type": "array", "items": {"type": "string"}}, "last_error_code": {"type": ["string", "null"]}, "updated_at": {"type": "string", "minLength": 1}, "validation_status": {"enum": ["complete", "missing_information", "invalid_information", null]}, "routing_status": {"enum": ["not_routed", "routed"]}, "applicant_notifications": {"type": "array", "items": {"$ref": "#/$defs/applicant_notice"}}, "operational_context": {"$ref": "#/$defs/operational_context"}, "assignment": {"$ref": "#/$defs/assignment"},
        "routing": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["target_department_id", "target_unit_id"], "properties": {"target_department_id": {"type": "string", "minLength": 1}, "target_unit_id": {"type": "string", "minLength": 1}}}]},
        "target_unit_notification": {}, "ticket": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["reference", "created_at"], "properties": {"reference": {"type": "string", "pattern": "^CA-[0-9A-F]{8}$"}, "created_at": {"type": "string", "minLength": 1}}}]}, "action_log": {"type": "array", "items": {"$ref": "#/$defs/action_log_item"}}, "learning_feedback": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["feedback_id", "status", "created_at"], "properties": {"feedback_id": {"type": "string", "minLength": 1}, "status": {"const": "candidate"}, "created_at": {"type": "string", "minLength": 1}}}]}, "behavior_signal": {"type": "object", "additionalProperties": false, "required": ["repeat_count", "aggression_score", "aggression_level", "marker_count", "priority_mode"], "properties": {"repeat_count": {"type": "integer", "minimum": 0}, "aggression_score": {"type": "number", "minimum": 0, "maximum": 1}, "aggression_level": {"enum": ["normal", "elevated", "high"]}, "marker_count": {"type": "integer", "minimum": 0}, "priority_mode": {"type": "boolean"}}}
      }
    }
  ],
  "$defs": {
    "applicant_notice": {"type": "object", "additionalProperties": false, "required": ["kind", "payload", "created_at"], "properties": {"kind": {"type": "string", "minLength": 1}, "payload": {}, "created_at": {"type": "string", "minLength": 1}}},
    "action_log_item": {"type": "object", "additionalProperties": false, "required": ["action_id", "type", "actor", "state", "case_revision", "completed_steps", "last_error_code", "occurred_at"], "properties": {"action_id": {"type": "integer", "minimum": 1}, "type": {"const": "state_projected"}, "actor": {"const": "system"}, "state": {"type": ["string", "null"]}, "case_revision": {"type": ["integer", "null"], "minimum": 1}, "completed_steps": {"type": "array", "items": {"type": "string"}}, "last_error_code": {"type": ["string", "null"]}, "occurred_at": {"type": "string", "minLength": 1}}},
    "operational_context": {"type": "object", "additionalProperties": false, "required": ["validated_fields", "department_id", "unit_id", "request_type_id", "document_summary", "draft_text"], "properties": {"validated_fields": {"type": "object"}, "department_id": {"type": ["string", "null"]}, "unit_id": {"type": ["string", "null"]}, "request_type_id": {"type": ["string", "null"]}, "document_summary": {"type": ["string", "null"]}, "draft_text": {"type": ["string", "null"]}}},
    "assignment": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["status", "unit_id", "staff_id", "display_name", "role", "open_assignment_count"], "properties": {"status": {"enum": ["assigned", "unassigned", "completed"]}, "unit_id": {"type": "string", "minLength": 1}, "staff_id": {"type": ["string", "null"]}, "display_name": {"type": ["string", "null"]}, "role": {"type": ["string", "null"]}, "open_assignment_count": {"type": "integer", "minimum": 0}, "selection_reason": {"type": "object", "additionalProperties": true}}}]}
  }
}
