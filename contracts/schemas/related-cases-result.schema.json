{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "related-cases-result",
  "title": "Same-applicant related case history",
  "description": "ADMIN-only bounded history. It never returns petition bodies, applicant identity values, staff identities, or assignments.",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "history_scope", "similar_count", "related_cases"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "history_scope": {"enum": ["same_validated_applicant", "unavailable"]},
    "similar_count": {"type": "integer", "minimum": 0},
    "related_cases": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "document_id", "state", "resolved", "submitted_at", "similarity_score", "title"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "document_id": {"type": "string", "minLength": 1},
          "state": {"type": "string", "minLength": 1},
          "resolved": {"type": "boolean"},
          "submitted_at": {"type": "string", "minLength": 1},
          "similarity_score": {"type": "integer", "minimum": 20, "maximum": 100},
          "title": {"type": ["string", "null"]}
        }
      }
    }
  }
}
