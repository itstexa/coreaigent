    {"service": "workflow", "method": "GET", "path": "/moderation-trends", "response": "case-abuse-trend-result"},
    {"service": "workflow", "method": "GET", "path": "/personnel-dashboard", "response": "personnel-dashboard-result"},
    {"service": "workflow", "method": "POST", "path": "/v1/normalize", "request": "normalize-request", "response": "normalize-result"},
    {"service": "workflow", "method": "GET", "path": "/cases/{case_id}/training-export", "response": "case-training-export"},
    {"service": "workflow", "method": "GET", "path": "/cases/{case_id}/history", "response": "case-history-result"},
    {"service": "workflow", "method": "POST", "path": "/cases/{case_id}/resolution-mark", "request": "empty-object", "response": "case-resolution-mark-result"},
    {"service": "workflow", "method": "GET", "path": "/cases/{case_id}/attachments", "response": "case-attachments-result"},
    {"service": "workflow", "method": "POST", "path": "/cases/{case_id}/attachments", "request": "case-attachment-add-request", "response": "case-attachment-add-result"},
    {"service": "workflow", "method": "GET", "path": "/cases/{case_id}", "response": "case-status-result"},
    {"service": "workflow", "method": "PATCH", "path": "/cases/{case_id}/edit", "request": "case-edit-request", "response": "case-edit-result"},
    {"service": "workflow", "method": "GET", "path": "/cases/{case_id}/revisions", "response": "case-revisions-result"},
    {"service": "workflow", "method": "GET", "path": "/cases/{case_id}/priority", "response": "case-priority-result"},
    {"service": "workflow", "method": "POST", "path": "/cases/{case_id}/priority-override", "request": "case-priority-override-request", "response": "case-priority-override-result"},
    {"service": "workflow", "method": "POST", "path": "/cases/{case_id}/review-completion", "request": "empty-object", "response": "review-completion-result"}
