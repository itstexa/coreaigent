{
  "schemaVersion": "3.0",
  "services": {
    "ocr": {"path": "/v1/ocr", "request": "document-input", "response": "ocr-result"},
    "classification": {"path": "/v1/classify", "request": "ocr-result", "response": "classification-result"},
    "validation": {"path": "/v1/validate", "request": "classification-result", "response": "validation-result"},
    "rag": {"path": "/v1/retrieve", "request": "rag-request", "response": "rag-result"},
    "llm": {"path": "/v1/generate", "request": "llm-request", "response": "llm-response"},
    "workflow": {"path": "/v1/workflows/document", "request": "document-input", "response": "workflow-result"}
  },
  "additionalEndpoints": [
    {"service": "validation", "method": "PATCH", "path": "/cases/{case_id}/supplemental-information", "request": "supplemental-information-request", "response": "validation-result"},
    {"service": "workflow", "method": "GET", "path": "/cases", "response": "case-list-result"},
    {"service": "workflow", "method": "POST", "path": "/cases/{case_id}/correspondence", "request": "empty-object", "response": "correspondence-start-result"},
    {"service": "workflow", "method": "GET", "path": "/cases/{case_id}/correspondence", "response": "case-correspondence-result"},
    {"service": "workflow", "method": "GET", "path": "/cases/{case_id}/routing", "response": "case-routing-result"},
    {"service": "workflow", "method": "GET", "path": "/cases/{case_id}/document", "response": "case-document"},
    {"service": "workflow", "method": "GET", "path": "/cases/{case_id}", "response": "case-status-result"},
    {"service": "workflow", "method": "POST", "path": "/cases/{case_id}/review-completion", "request": "empty-object", "response": "review-completion-result"}
  ],
  "errorResponse": "standard-error"
}
