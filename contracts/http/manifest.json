    {"service": "workflow", "method": "GET", "path": "/cases/{case_id}/routing", "response": "case-routing-result"},
    {"service": "workflow", "method": "GET", "path": "/cases/{case_id}/routing-evaluation", "response": "case-routing-evaluation-result"},
